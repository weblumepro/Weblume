{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/introJPG/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
